# Copy to .env and edit. .env is gitignored; this file is not.
#
#   cp .env.example .env

# --- Project ----------------------------------------------------------------

# Required, and the only setting with no default: the compose project to watch.
# It is the `name:` key of that project's compose file, which is also what its
# containers are labelled with. There is no sensible default — guessing would
# quietly monitor the wrong project — so the service refuses to start without it.
PROJECT_NAME=

# What the page calls the project. Defaults to PROJECT_NAME.
#PROJECT_TITLE=

# How often the project is re-read regardless of whether the daemon reported a
# change. The event stream is the primary trigger; this is the backstop for a
# stream that drops silently.
#PROJECT_INTERVAL=30s

# How long to wait for the daemon to stop reporting changes before re-reading.
# A `compose up` emits a burst of events, and this turns it into one read.
#PROJECT_DEBOUNCE=250ms

# --- Docker -----------------------------------------------------------------

# The socket to read. Mount it read-only; the service only ever lists
# containers and reads the event stream.
#DOCKER_HOST=unix:///var/run/docker.sock

# --- Control ----------------------------------------------------------------

# Whether the page may act on containers: starting a stopped one, stopping a
# running one, and removing a stopped one. Off by default.
#
# The page has no authentication of its own, so turning this on says that
# anyone who can reach it is allowed to stop and remove containers. Left off,
# the service never holds a handle that can act on one, and the endpoints
# refuse even when called directly — which also lets the socket proxy in
# compose.yaml keep POST and DELETE denied, the stronger guarantee.
#CONTROL_ENABLED=false

# --- HTTP -------------------------------------------------------------------

#HTTP_HOST=0.0.0.0
#HTTP_PORT=8080

# How often the event stream emits a comment frame, so an idle connection is
# not closed by a proxy during a long stretch where nothing changes.
#HTTP_KEEP_ALIVE=20s

#HTTP_READ_HEADER_TIMEOUT=15s
#HTTP_IDLE_TIMEOUT=60s
#HTTP_SHUTDOWN_TIMEOUT=10s

# --- Logging ----------------------------------------------------------------

#LOG_LEVEL=info
#LOG_FORMAT=text

# --- Application ------------------------------------------------------------

#APP_MODE=production
